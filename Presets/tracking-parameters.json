{
  "_comment": [
    "Query parameters stripped from a link before it is opened.",
    "",
    "'global' entries are removed from every URL, so only add a parameter here when it is",
    "unambiguously tracking. A false positive silently breaks links, which is far worse than",
    "leaving a tracker in place — when in doubt, scope it to a host instead.",
    "",
    "'hostScoped' entries are removed only on that host and its subdomains. This is where short or",
    "generic names belong: 's' is a share token on x.com and a search query almost everywhere else."
  ],
  "global": {
    "prefixes": ["utm_", "pk_", "mtm_", "matomo_", "piwik_", "hsa_"],
    "names": [
      "fbclid",
      "fb_action_ids",
      "fb_action_types",
      "fb_source",
      "gclid",
      "gclsrc",
      "dclid",
      "gbraid",
      "wbraid",
      "gad_source",
      "srsltid",
      "msclkid",
      "twclid",
      "ttclid",
      "igshid",
      "igsh",
      "yclid",
      "ysclid",
      "_openstat",
      "mc_cid",
      "mc_eid",
      "mkt_tok",
      "_hsenc",
      "_hsmi",
      "__hssc",
      "__hstc",
      "__hsfp",
      "_ke",
      "vero_conv",
      "vero_id",
      "oly_anon_id",
      "oly_enc_id",
      "epik",
      "irclickid",
      "rb_clickid",
      "s_kwcid",
      "ef_id",
      "wickedid",
      "ml_subscriber",
      "ml_subscriber_hash"
    ]
  },
  "hostScoped": [
    { "host": "youtube.com", "names": ["si", "pp"] },
    { "host": "youtu.be", "names": ["si"] },
    { "host": "open.spotify.com", "names": ["si", "nd"] },
    { "host": "x.com", "names": ["s", "t", "ref_src", "ref_url"] },
    { "host": "twitter.com", "names": ["s", "t", "ref_src", "ref_url"] },
    { "host": "linkedin.com", "names": ["trk", "trackingid", "originalsubdomain"] }
  ]
}
